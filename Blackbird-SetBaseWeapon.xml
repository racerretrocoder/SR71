                    <float n="6" alias="/fdm/jsbsim/propulsion/engine[1]/set-thrust"/>
                    <float n="7" alias="/engines/engine[0]/nozzle-pos-norm"/>
                    <float n="8" alias="/engines/engine[1]/nozzle-pos-norm"/>
                    <float n="9" alias="/velocities/mach"/>
					<float n="10" alias="/velocities/down-relground-fps"/>
					<float n="11" alias="/velocities/east-relground-fps"/>
					<float n="12" alias="/velocities/north-relground-fps"/>
					<float n="13" alias="/velocities/speed-down-fps"/>
					<float n="14" alias="/velocities/speed-east-fps"/>
					<float n="15" alias="/velocities/speed-north-fps"/>
					<float n="16" alias="/velocities/uBody-fps"/>
					<float n="17" alias="/velocities/vBody-fps"/>
					<float n="18" alias="/velocities/wBody-fps"/>
					<float n="19" alias="/fdm/jsbsim/aero/rentry/plasma-coeff"/>
