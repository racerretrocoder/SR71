					<transparent type="bool">true</transparent>
					<red type="float">1.0</red>
					<green type="float">0.2</green>
					<blue type="float">0.0</blue>
				</color>
			</palette>
   
		</hud>
        <systems>
            <autopilot>
                <path>Aircraft/SR71/Systems/SR71autopilot.xml</path>
            </autopilot>
            <electrical>
                <path>Aircraft/SR71/Systems/dummy-electrical.xml</path>
            </electrical>
            <autoflight>
                <serviceable type="bool">true</serviceable>
            </autoflight>
        </systems>
        <rendering>
                <redout>
                    <red>0</red>
                    <alpha>0</alpha>
                    <enabled type="bool">false</enabled>
                </redout>
        </rendering>
        <multiplay>
		            <visibility-range-nm type="int">2000</visibility-range-nm>
            <generic>
                    <float n="0" alias="/surface-positions/gear-pos-norm"/>
                    <float n="1" alias="/surface-positions/chute-pos-norm"/>
                    <float n="2" alias="/surface-positions/canopy-pos-norm"/>
                    <float n="3" alias="/gear/gear[0]/steering-norm"/>
                    <float n="4" alias="/fdm/jsbsim/fcs/landing-light"/>
