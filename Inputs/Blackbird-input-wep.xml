<PropertyList>

    <keyboard>


<key n="101">
  <name>e</name>
  <desc>Fire selected WCS weapon</desc>
	<binding>
		<command>nasal</command>
		<script>setprop("controls/armament/trigger",1);#guns.fire_MG();</script>
	</binding>
    <binding>
   <command>property-toggle</command>
   <property>controls/missile</property>
  </binding>

  <mod-up>
    <binding>
      <command>nasal</command>
      <script>setprop("controls/armament/trigger",0);guns.stopFiring();</script>
    </binding>
    <binding>
      <command>nasal</command>
      <script>setprop("/controls/armament/missile-trigger", 0);</script>
    </binding>
  </mod-up>
 </key>

 <key n="109">
  <name>m</name>
  <desc>Cycle selected WCS AA weapon</desc>
  <binding>
 <command>property-cycle</command>
 <property>controls/armament/selected-weapon</property>
 <value>ASM-9</value>
 <value>ASM-120</value>
 <value>Aim-260</value>
</binding>
  <binding>
 <command>property-cycle</command>
 <property>controls/armament/selected-weapon-digit</property>
 <value>1</value>
 <value>2</value>
 <value>4</value>
</binding>
  <binding><command>nasal</command><script>screen.log.write("Selected " ~ getprop("controls/armament/selected-weapon"),0.5,0.5,1);var weaponname = getprop("controls/armament/selected-weapon");missile.Loading_missile(weaponname);</script></binding>
   <binding><command>nasal</command><script>setprop("/controls/baydoors/AIM120", 0)</script></binding>
      <binding><command>nasal</command><script>setprop("/controls/missile", 3)</script></binding>
 </key> 
		

		 <key n="110">
  <name>n</name>
  <desc>Cycle selected WCS AG weapon</desc>
  <binding>
 <command>property-cycle</command>
 <property>controls/armament/selected-weapon</property>

 <value>SGM-120</value>
 <value>JDAM</value>
</binding>
  <binding>
 <command>property-cycle</command>
 <property>controls/armament/selected-weapon-digit</property>

 <value>3</value>

  <value>4</value>
</binding>
  <binding><command>nasal</command><script>screen.log.write("Selected " ~ getprop("controls/armament/selected-weapon"),0.5,0.5,1);var weaponname = getprop("controls/armament/selected-weapon");missile.Loading_missile(weaponname);</script></binding>
   <binding><command>nasal</command><script>setprop("/controls/baydoors/AIM120", 0)</script></binding>
      <binding><command>nasal</command><script>setprop("/controls/missile", 3)</script></binding>
 </key> 


 
		 <key n="105">
  <name>i</name>
  <desc>Cycle selected DEBUG MISSILE</desc>
  <binding>
 <command>property-cycle</command>
 <property>controls/armament/selected-weapon</property>

 <value>Aim-7</value>
 <value>XMAA</value>
 <value>Aim-9m</value>
</binding>
  <binding>
 <command>property-cycle</command>
 <property>controls/armament/selected-weapon-digit</property>

 <value>5</value>

  <value>6</value>
</binding>
  <binding><command>nasal</command><script>screen.log.write("Selected Debug missile: " ~ getprop("controls/armament/selected-weapon"),0.5,0.5,1);</script></binding>
 </key> 


<key n="119">
  <name>w</name>
  <desc>Cycle Gun/Missile</desc>
  <binding>
 <command>property-cycle</command>
 <property>controls/armament/stick-selector</property> <!--Working!! :D-->
 <value>1</value>
 <value>2</value>
</binding>
 </key> 	

 <key n="108">
	 <name>l</name>
     <desc>Trigger flare release</desc>      
	 <binding>
     <command>nasal</command>
 <script>CMS.updatecms();CMS.trigger();</script>
      </binding>
  <binding>
   <command>property-toggle</command>
   <property>controls/flare</property>
  </binding>

    </key>
	 <key n="114">
  <name>r</name>
  <desc>Switch Radar Range</desc>
  <binding>
 <command>nasal</command>
 <script>radar.switch_distance();screen.log.write("Radar Range: " ~ f22.myRadar.rangeTab[radar.rangeIndex] ~ "nm.",1,1,0);</script>
</binding>
 </key> 
<key n="121">
  <name>y</name>
  <desc>select target</desc>
  <binding>
 <command>nasal</command>
 <script>radar.next_Target_Index();</script>
</binding>
</key>


            <key n="1">
            <name>Ctrl-A</name>
            <desc>Toggle autopilot altitude lock.</desc>
                    <binding>
                            <command>property-toggle</command>
                            <property>/autopilot/switch-altitude</property>
                    </binding>
            </key>
            <!--<key n="8">
            <name>Ctrl-H</name>
            <desc>Toggle autopilot heading lock.</desc>
                    <binding>
                            <command>property-toggle</command>
                            <property>/autopilot/switch-heading</property>
                    </binding>
            </key>-->
            <key n="100">
                <name>d</name>
                <desc>Toggle Canopy</desc>
                    <binding>
                            <command>property-toggle</command>
                            <property>/controls/flight/canopy</property>
                    </binding>
            </key>
            <key n="70">
                <name>F</name>
                <desc>Air Refuel On/Off</desc>
                    <binding>
                            <command>property-toggle</command>
                            <property>/controls/flight/op-refuel</property>
                    </binding>
            </key>
            <key n="2">
                <name>Ctrl-b</name>
                <desc>Braking Chute Deploy</desc>
                <binding>
                        <property>sim/model/controls/chute</property>
                        <command>property-assign</command>
                        <value>1</value>
                </binding>
        </key>

  <key n="127">
		<name>Delete</name>
		<desc>Toggle Reversers</desc>
		<binding>
			<command>nasal</command>
			<script>reversethrust.togglereverser();screen.log.write("Toggling reverse thrust");</script>
		</binding>
		</key>	
  

        <key n="106">
                <name>j</name>
                <desc>Braking Chute Reload</desc>
                <binding>
                        <property>sim/model/controls/chute</property>
                        <command>property-assign</command>
                        <value>0</value>
                </binding>
                <binding>
                        <property>/fdm/jsbsim/fcs/chute-switch-once</property>
                        <command>property-assign</command>
                        <value>0</value>
                </binding>
                <binding>
                        <property>/fdm/jsbsim/fcs/chute-switch-count</property>
                        <command>property-assign</command>
                        <value>0</value>
                </binding>
        </key>
        <key n="125">
                <name>}</name>
                <desc>Master Electric  Switch</desc>
                        <binding>
                                <command>property-toggle</command>
                                <property>/controls/electric/master-switch</property>
                        </binding>
        </key>
        <key n="123">
                <name>{</name>
                <desc>Cutoff ON/OFF</desc>
                        <binding>
                                <command>property-toggle</command>
                                <property>/fdm/jsbsim/fcs/cutoff-switch</property>
                        </binding>
        </key>
        <key n="115">
            <name>s</name>
            <desc>Fire Starter on Selected Engine(s)</desc>
            <binding>
                <command>nasal</command>
                <script>sr71.start_engine(1,1)</script>
            </binding>
            <mod-up>
                <binding>
                    <command>nasal</command>
                    <script>sr71.start_engine(1,2)</script>
                </binding>
            </mod-up>
        </key>

        </keyboard>
</PropertyList>